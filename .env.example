# ============================================================================
# Didit ID — Documentation (Mintlify). No runtime environment is required to
# serve or deploy the docs. Live at https://didit-id.mintlify.site/
# ----------------------------------------------------------------------------
# Local preview (needs node@22, NOT 25):
#   PATH="$(brew --prefix node@22)/bin:$PATH" mint dev --port 3014
#
# The vars below are used ONLY by the API-reference regeneration scripts
# (scripts/capture_examples.py + _capture_crypto.py) which drive a locally
# running credentials service to capture real request/response examples.
# ============================================================================

# Path to the credentials-service source (for the SD-JWT crypto sidecar during
# example capture). Defaults to ../didit-credentials-service/src if unset.
CRED_SERVICE_SRC=../didit-credentials-service/src

# Base URL of a locally running credentials service to capture examples against.
CREDENTIALS_SERVICE_BASE=http://localhost:8011
